# Media Streamer Configuration

# Server Port
PORT=3000

# Environment (development, production)
NODE_ENV=production

# Media Storage Path (relative to project root)
MEDIA_DIR=./media

# Upload Limits
MAX_FILE_SIZE=524288000  # 500MB in bytes

# Allowed File Extensions (comma-separated)
ALLOWED_EXTENSIONS=mp4,mp3,webm,ogg,wav,avi,mkv,mov

# CORS Settings (comma-separated origins, or * for all)
CORS_ORIGIN=*

# Log Level (error, warn, info, debug)
LOG_LEVEL=info
